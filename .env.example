# Copy to .env.local (git-ignored) for local development; add the same keys in Vercel > Settings > Environment Variables.
# Full setup: backend/README.md

# ── Live store (Supabase) ──
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# # Public address used in sitemap.xml, robots.txt and llms.txt
# SITE_URL=https://kridhyabydevanshi.com

# # ── Preview mode only (used when the Supabase keys above are empty) ──
# # Set with: npm run admin:password -- "your password"   (writes these two lines to .env.local)
# # VITE_ADMIN_PASSWORD_HASH must be the 64-character hash, NOT the password itself.
# VITE_ADMIN_USER=admin
# VITE_ADMIN_PASSWORD_HASH=
# VITE_SUPABASE_URL=https://fhvqfpzhhcxgrdmfyiql.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Kbs2kLxXsSPfPzSDZAfLIw_7y43TtsB
# ── Server only (never prefix with VITE_) - payments + shipping. Full guide: backend/README.md ──
SUPABASE_SECRET_KEY=
RAZORPAY_KEY_ID=
